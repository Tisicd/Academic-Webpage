# Configuración para Docker - Copiar como .env

# Flask
SECRET_KEY=tu_clave_secreta_muy_segura
FLASK_ENV=development
FLASK_APP=run.py

# PostgreSQL
POSTGRES_DB=uce_economia_db
POSTGRES_USER=uce_user
POSTGRES_PASSWORD=uce_password
POSTGRES_HOST=db
SQLALCHEMY_DATABASE_URI=postgresql://uce_user:uce_password@db:5432/uce_economia_db

# Redis
SESSION_REDIS=redis://redis:6379/0
SESSION_EXPIRATION=7200

# Email
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=tu_email@gmail.com
MAIL_PASSWORD=tu_password
MAIL_DEFAULT_SENDER=tu_email@gmail.com

# Upload
UPLOAD_FOLDER=/app/app_recursos/app/uploads

