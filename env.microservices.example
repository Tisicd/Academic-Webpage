# ==========================================
# Configuración para Arquitectura Distribuida
# Sistema de Recursos Educativos UCE
# ==========================================
# Copiar este archivo como .env y configurar valores reales

# ==================== GENERAL ====================
SECRET_KEY=tu_clave_secreta_muy_segura_aqui
FLASK_ENV=production

# ==================== SERVICIOS ====================
AUTH_SERVICE_URL=http://auth_service:5001
RECURSOS_SERVICE_URL=http://recursos_service:5002
ANALYTICS_SERVICE_URL=http://analytics_service:5003

# ==================== BASES DE DATOS ====================
AUTH_DB_URL=postgresql://uce_user:uce_pass@postgres_auth:5432/uce_auth_db
RECURSOS_DB_URL=postgresql://uce_user:uce_pass@postgres_recursos:5432/uce_recursos_db
ANALYTICS_DB_URL=postgresql://uce_user:uce_pass@postgres_analytics:5432/uce_analytics_db

# ==================== REDIS ====================
REDIS_URL=redis://redis:6379/0

# ==================== S3/MinIO ====================
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin_secret

# ==================== EMAIL ====================
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=tu_email@gmail.com
MAIL_PASSWORD=tu_password

# ==================== MONITOREO ====================
GRAFANA_PASSWORD=admin

